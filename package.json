{
  "name": "telemax",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/app.ts",
    "build": "esbuild src/server/app.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "NODE_ENV=production node dist/server.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:cli": "tsx scripts/dev/auth-cli.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "fzstd": "^0.1.1",
    "https-proxy-agent": "^9.1.0",
    "lottie-web": "^5.13.0",
    "lz4js": "^0.2.0",
    "msgpackr": "^2.0.5",
    "puppeteer-core": "^25.6.0",
    "socks-proxy-agent": "^10.1.0",
    "telegraf": "^4.16.3",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  }
}
