# 32-byte key, hex-encoded (64 hex chars), used to encrypt the persisted MAX session token.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAX_SESSION_KEY=

# Опционально: адрес сервера MAX. По умолчанию (пусто) подключаемся по имени
# api2.oneme.ru — это единственный рабочий путь для IPv6-only хостов (резолв имени
# даёт DNS64/NAT64; захардкоженный IPv4-литерал этот путь обходит и рвётся раз в ~несколько
# часов). Пиньте IP сюда, только если DNS для oneme.ru недоступен. MAX_SNI при этом
# оставляйте api2.oneme.ru, иначе не сойдётся TLS-сертификат сервера.
# MAX_HOST=155.212.204.150
# MAX_SNI=api2.oneme.ru

# Глубина истории (1 день, 7 дней, 30 дней, вся) выбирается в Telegram: бот спрашивает перед первой
# заливкой, потом — /panel → ⚙️ Система → «📜 История» (по умолчанию 7 дней). Здесь — необязательный
# дополнительный предел: не больше стольких последних сообщений каждого чата.
# HISTORY_LIMIT=300

# Сообщение, доставленное с опозданием больше 5 минут (заливка истории, догрузка после простоя),
# получает в конце строку «🕓 10.09.2026, 11:27» — когда его на самом деле отправили в MAX.
# Время — по TZ (по умолчанию московское). Выключить: BACKFILL_TIME=off
# BACKFILL_TIME=off

# Опционально: версия десктопного MAX, которой представляется мост. Нужна, только если при /login
# MAX отвечает «Приложение устарело» (см. README, «Если что-то не работает»). Пусто — встроенная.
# MAX_APP_VERSION=26.38.0
# MAX_BUILD_NUMBER=82021

# Optional — the bridge stays MAX-only (no Telegram forwarding) until both are set.
TELEGRAM_BOT_TOKEN=
TARGET_TELEGRAM_GROUP=

# Опционально: прокси для Telegram, если сервер выходит в Telegram только через него
# (напр. домашний сервер, где прямой доступ к api.telegram.org закрыт). MAX всегда
# идёт напрямую, минуя прокси. Форматы: socks5://[логин:пароль@]хост:порт или
# http://[логин:пароль@]хост:порт. Пусто — без прокси.
TELEGRAM_PROXY=

# Анимированные стикеры (.tgs): full = проигрываются видео (+~1.4 ГБ к образу), slim = уходят
# картинкой. setup.sh спрашивает при установке и записывает сюда. Значение хранится в .env, но
# действует как build-arg образа (docker-compose.yml подставляет его при СБОРКЕ), поэтому после
# смены нужна пересборка: ./setup.sh → «Переключить режим стикеров» или вручную поменять строку
# ниже и выполнить docker compose build && docker compose up -d. (Разовое STICKERS=slim в
# окружении не поможет: следующая пересборка при обновлении снова возьмёт значение из .env.)
STICKERS=full
