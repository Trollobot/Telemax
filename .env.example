# Секреты можно не держать в этом файле: у TELEGRAM_BOT_TOKEN, MAX_SESSION_KEY, TELEGRAM_PROXY и
# TARGET_TELEGRAM_GROUP есть вариант с суффиксом _FILE —
# путь к файлу со значением (как Docker secrets: TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token,
# MAX_SESSION_KEY_FILE=/run/secrets/max_session_key). Если задана и сама переменная, побеждает она.

# 32-byte key, hex-encoded (64 hex chars), used to encrypt the persisted MAX session token.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAX_SESSION_KEY=

# Опционально: адрес сервера MAX. По умолчанию (пусто) подключаемся по имени
# api2.oneme.ru — это единственный рабочий путь для IPv6-only хостов (резолв имени
# даёт DNS64/NAT64; захардкоженный IPv4-литерал этот путь обходит и рвётся раз в ~несколько
# часов). Пиньте IP сюда, только если DNS для oneme.ru недоступен. MAX_SNI при этом
# оставляйте api2.oneme.ru, иначе не сойдётся TLS-сертификат сервера.
# MAX_HOST=155.212.204.150
# MAX_SNI=api2.oneme.ru

# Глубина истории (1 день, 7 дней, 30 дней, вся) выбирается в Telegram: бот спрашивает перед первой
# заливкой, потом — /panel → ⚙️ Система → «📜 История» (по умолчанию 7 дней). Здесь — необязательный
# дополнительный предел: не больше стольких последних сообщений каждого чата.
# HISTORY_LIMIT=300

# Сообщение, доставленное с опозданием больше 5 минут (заливка истории, догрузка после простоя),
# получает в конце строку «🕓 10.09.2026, 11:27» — когда его на самом деле отправили в MAX.
# Время — по TZ (по умолчанию московское). Выключить: BACKFILL_TIME=off
# BACKFILL_TIME=off

# Опционально: подробность журнала (docker compose logs). debug — всё подряд, для разбора проблемы;
# info (по умолчанию) — обычная работа; warn и error — только предупреждения и ошибки.
# LOG_LEVEL=debug

# Опционально: версия десктопного MAX, которой представляется мост. Нужна, только если при /login
# MAX отвечает «Приложение устарело» (см. README, «Если что-то не работает»). Пусто — встроенная.
# MAX_APP_VERSION=26.41.1
# MAX_BUILD_NUMBER=83827

# Опционально: файлы MAX — только с доменов MAX. Сейчас мост лишь пишет в журнал, если ссылка на файл
# ведёт на незнакомый домен («A MAX file URL outside the known MAX hosts»), и скачивает как раньше.
# MAX_HOST_CHECK=enforce — отказывать таким ссылкам. Свои домены к списку — через запятую:
# MAX_HOST_CHECK=enforce
# MAX_HOST_SUFFIXES_EXTRA=

# Опционально: история и догрузка приходят без звука (по умолчанию). QUIET_HISTORY=off — звенят как новые.
# QUIET_HISTORY=off

# Большие файлы (больше лимитов Telegram) идут по ссылкам: их раздаёт служба files-service, пока есть
# живые ссылки — тогда открыты порты 80 и 443 (сертификат Let's Encrypt на IP сервера). Установщик
# сам ставит FILES=off, если у сервера нет белого IP или порты заняты. Подробно — README, «Большие файлы».
# FILES=off                  # не пересылать большие файлы, порты 80/443 не трогать
# FILES_DOMAIN=              # свой домен вместо IP-адреса
# FILES_PUBLIC_URL=          # за своим веб-сервером: https://example.ru/tlmx-files
# FILES_LISTEN=              # …и локальный порт службы для него: 127.0.0.1:3300

# Опционально: обычные (неподвижные) стикеры из Telegram уходят в MAX как настоящие стикеры MAX —
# с прозрачным фоном. off — слать их картинкой, как раньше.
# NATIVE_STICKERS=off

# Опционально: не пересылать в MAX то, что дошло до моста из Telegram позже стольких минут (мост был
# недоступен, Telegram копит сообщения до суток) — в теме появится пометка «отправьте заново».
# По умолчанию выключено: пересылается всё. Под правило попадают и команды; часы сервера должны идти точно.
# STALE_TELEGRAM_MINUTES=10

# Опционально: проверка версий при недоступном GitHub идёт на зеркало проекта. MIRROR_BASE_URL=off —
# не обращаться ни к чему, кроме GitHub; свой адрес — своё зеркало.
# MIRROR_BASE_URL=off

# Optional — the bridge stays MAX-only (no Telegram forwarding) until both are set.
TELEGRAM_BOT_TOKEN=
TARGET_TELEGRAM_GROUP=

# Опционально: прокси для Telegram, если сервер выходит в Telegram только через него
# (напр. домашний сервер, где прямой доступ к api.telegram.org закрыт). MAX этот прокси
# не касается (см. MAX_PROXY ниже). Форматы: socks5://[логин:пароль@]хост:порт или
# http://[логин:пароль@]хост:порт. Пусто — без прокси.
TELEGRAM_PROXY=

# Опционально: прокси для MAX — если сервер за рубежом и MAX с него недоступен. Прокси должен быть
# в России. Через него идут соединение с MAX и файлы; сертификат MAX проверяется как обычно.
# Задать можно и из Telegram (/panel → Система → Прокси для MAX) — та настройка важнее этой.
# MAX_PROXY=socks5://логин:пароль@хост:порт

# Анимированные стикеры (.tgs): full = проигрываются видео (+~1.4 ГБ к образу), slim = уходят
# картинкой. setup.sh спрашивает при установке и записывает сюда. Значение хранится в .env, но
# действует как build-arg образа (docker-compose.yml подставляет его при СБОРКЕ), поэтому после
# смены нужна пересборка: ./setup.sh → «Переключить режим стикеров» или вручную поменять строку
# ниже и выполнить docker compose build && docker compose up -d. (Разовое STICKERS=slim в
# окружении не поможет: следующая пересборка при обновлении снова возьмёт значение из .env.)
STICKERS=full
